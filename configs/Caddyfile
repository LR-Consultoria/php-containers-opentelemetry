# FrankenPHP / Caddy configuration for Laravel applications.
# Docs: https://frankenphp.dev/docs/config/
{
	skip_install_trust
	auto_https off
	admin off

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	log {
		output stdout
		format console
	}
}

:80 {
	# Document root (Laravel public directory)
	root * /var/www/public

	# Compression
	encode zstd br gzip

	# Static file handling with caching
	@static {
		file
		path *.css *.js *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer-when-downgrade"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Deny access to sensitive files
	@forbidden {
		path /.env*
		path /.git*
		path /storage/*
		path /bootstrap/cache/*
		path *.log
	}
	respond @forbidden 403

	# Health check endpoint
	handle /health {
		respond "healthy" 200
	}

	# Execute PHP files and serve assets (FrankenPHP; not PHP-FPM)
	php_server
}
